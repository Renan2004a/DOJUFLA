# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NÃO é versionado.

# Chave de sessão do Flask (use algo aleatório e longo)
DOJUFLA_SECRET_KEY=troque-por-uma-chave-aleatoria-bem-grande

# --- LLMs (basta preencher a chave do provedor que quiser habilitar) ---
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Provedor padrão para novos usuários: ollama | groq | gemini
DEFAULT_LLM=ollama

# --- Opcionais ---
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3
# GROQ_MODEL=qwen/qwen3.8-27b      # rapido, responde direto (recomendado)
# GROQ_MODEL=openai/gpt-oss-120b   # mais forte, porem "pensa" antes (mais lento)
# GROQ_REASONING_EFFORT=low        # so usado pelos modelos gpt-oss
# GEMINI_MODEL=gemini-2.0-flash
# EMBED_MODEL=all-MiniLM-L6-v2
# RETRIEVE_K=4
# CHUNK_SIZE=800
# PASSWORD_MIN_LENGTH=6
# MAX_UPLOAD_MB=40
