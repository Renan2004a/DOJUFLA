# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NÃO é versionado.

# Chave de sessão do Flask (use algo aleatório e longo)
DOJUFLA_SECRET_KEY=troque-por-uma-chave-aleatoria-bem-grande

# Chave da API Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# LLM padrão para novos usuários: "ollama" (local) ou "groq" (nuvem)
DEFAULT_LLM=ollama

# Opcionais
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3
# GROQ_MODEL=llama-3.3-70b-versatile
