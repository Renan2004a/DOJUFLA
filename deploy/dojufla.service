[Unit]
Description=DOJUFLA (Flask + gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/DOJUFLA
EnvironmentFile=/home/ubuntu/DOJUFLA/.env
ExecStart=/home/ubuntu/DOJUFLA/venv/bin/gunicorn app:app --workers 1 --bind 127.0.0.1:8000 --timeout 180
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
